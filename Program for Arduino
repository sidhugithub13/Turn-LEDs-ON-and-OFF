//LED using arduino 
void setup() { 
  // put your setup code here, to run once: 
  pinMode (9, OUTPUT); 
  pinMode (10, OUTPUT); 
  pinMode (11, OUTPUT); 
  pinMode (12, OUTPUT); 
} 
 
void loop() { 
  // put your main code here, to run repeatedly: 
  digitalWrite(9, HIGH); 
  digitalWrite(10, LOW); 
  delay(1000); 
  digitalWrite(11, HIGH); 
  digitalWrite (12, LOW); 
  delay(2000); 
  digitalWrite(10, HIGH); 
  digitalWrite(9, LOW); 
  delay(1500); 
  digitalWrite(12, HIGH); 
  digitalWrite(11, LOW); 
  delay(1000); 
 
} 
